__pycache__/
*.pyc
.pytest_cache/
data/*.npz
observation_*.json
*.tmp

# Resumable harness logs: append-only run state, regenerated by re-running.
results/logs/
# Stale lock files from the experiment registry.
*.lock

# Generated: the Overleaf upload bundle, rebuilt by scripts4/prepare_overleaf.py
paper/*_overleaf.zip

# LaTeX intermediates. The PDF itself IS committed -- the paper is a
# deliverable and building it needs four packages a clean container lacks
# (see paper/build.sh) -- but the aux/log/out files are per-run noise.
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc

# Crash-resume journal for scripts4/exploitability.py. Regenerated by the run,
# and a stale one would silently resume a DIFFERENT run's deals.
results/exploitability_journal.jsonl
results/ii_endgame_journal.jsonl
# One journal per layer now: the shared file was keyed by game index alone, so
# an m = 2 run started with an m = 1 journal present would have skipped all its
# games as done and reported the wrong layer's positions.
results/ii_endgame_journal_m*.jsonl
results/ii_first_endgame_journal.jsonl

# Short runs of the study scripts, which write here instead of to the results
# filename precisely so a regression check cannot be mistaken for a
# measurement. The scripts stamp them "Do not cite it"; committing one puts a
# citable-looking file in results/ saying the opposite.
results/*_smoke.json

# A run in flight appends here; scripts4/journal.py renames it on completion.
# See that file: a tracked journal that changes on every flush means the tree
# is never clean while a measurement is running.
*.jsonl.partial

# The FishLab package is a build artifact -- fishlab/build.py makes it from
# the manifest, bot.py and the vendored engine.
fishlab/kraken.zip
