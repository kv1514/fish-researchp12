<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fish_bg</item>
        <item name="colorPrimaryDark">@color/fish_bg</item>
        <item name="colorAccent">@color/fish_accent</item>
        <item name="android:windowBackground">@color/fish_bg</item>
        <item name="android:statusBarColor">@color/fish_bg</item>
        <item name="android:navigationBarColor">@color/fish_bg</item>
    </style>

    <!-- The game screen, after the launch screen. Dark behind the status and
         navigation bars, with light icons (set again in MainActivity for the
         versions that draw edge to edge). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/fish_bg</item>
        <item name="android:statusBarColor">@color/fish_bg</item>
        <item name="android:navigationBarColor">@color/fish_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch screen: the app icon on the app's dark background (Android 12+
         draws it from these; older versions show @drawable/splash). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/fish_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
